# Database
DATABASE_URL="postgresql://user:password@localhost:5432/overtime_db?schema=public"

# Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Application
PORT=3000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3001"

# CORS (can be comma-separated for multiple origins)
CORS_ORIGIN="http://localhost:3001"

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ============================================
# RESEND (Email Service)
# ============================================
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxx"
RESEND_FROM_EMAIL="Overtime <noreply@your-domain.com>"
RESEND_REPLY_TO="soporte@your-domain.com"
RESEND_ENABLED="false"

# ============================================
# MERCADOPAGO (Payment Gateway)
# ============================================
# Get your credentials from https://www.mercadopago.com.ar/developers/panel/credentials
MERCADOPAGO_ACCESS_TOKEN="APP_USR-xxxxxxxxxx"
MERCADOPAGO_PUBLIC_KEY="APP_USR-xxxxxxxxxx"
MERCADOPAGO_WEBHOOK_SECRET="your-webhook-secret"
MERCADOPAGO_ENABLED="false"

# URLs for MercadoPago redirect after payment
MERCADOPAGO_SUCCESS_URL="http://localhost:3001/payments/success"
MERCADOPAGO_FAILURE_URL="http://localhost:3001/payments/failure"
MERCADOPAGO_PENDING_URL="http://localhost:3001/payments/pending"

# Webhook URL (must be publicly accessible)
# For local development, use ngrok or similar: https://your-ngrok-url.ngrok.io/api/payments/webhooks/mercadopago
MERCADOPAGO_NOTIFICATION_URL=""
